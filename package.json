{
    "name": "llm-local-chat",
    "displayName": "llm-local-chat",
    "description": "local llm vs extension",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kubakoltun/llm-local-chat-vs.git"
    },
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:llm-local-chat.openLLMWindow"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "llm-local-chat.openLLMWindow",
                "title": "openllmwindow"
            }
        ]
    },
    "scripts": {
        "eslint": "eslint .",
        "test": "vscode-test",
        "pack-extension": "vsce package",
        "start-ollama": "ollama serve",
        "download-model": "ollama serve && ollama pull gemma4:31b"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "20.x",
        "@types/vscode": "^1.96.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^8.57.1"
    },
    "dependencies": {
        "ollama": "^0.5.12",
        "vsce": "^2.15.0"
    }
}
